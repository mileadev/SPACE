# Export these from your shell or a secret manager; do not commit real values.
SPACE_API_URL=http://127.0.0.1:8080
SPACE_DATA_PLANE_URL=http://127.0.0.1:8090
SPACE_API_TOKEN=
SPACE_TEMPLATE=seed:latest
# All mutations are disabled unless explicitly enabled.
SPACE_MCP_ALLOW_CREATE=0
SPACE_MCP_ALLOW_EXEC=0
SPACE_MCP_ALLOW_DELETE=0
# IDs of existing sandboxes that this process may inspect or execute in.
SPACE_MCP_SANDBOX_IDS=
OLLAMA_LOCAL_URL=http://127.0.0.1:11434
SPACE_MCP_MODELS_OLLAMA_LOCAL=llama3.2
# Ollama direct cloud: https://ollama.com/api/chat
OLLAMA_API_KEY=
SPACE_MCP_MODELS_OLLAMA_CLOUD=
# Bedrock uses AWS SSO/role/default credential chain; never put keys in guests.
AWS_REGION=
SPACE_MCP_MODELS_BEDROCK=
# HTTP transport (optional): bind 127.0.0.1 only; token >=32 chars.
SPACE_MCP_HTTP_PORT=8765
SPACE_MCP_HTTP_TOKEN=
